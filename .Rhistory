ggplot(monthly_2022, aes(x = month, y = transation_counts, colour = suburb, group = suburb)) +
geom_line(linewidth = 2) +
geom_point(size = 3) +
scale_x_continuous(1:12, labels = month.abb) +  # 12 months and show as abbr, saving space and looks tidier.
labs(title = "Monthly property transactions in 2022",
