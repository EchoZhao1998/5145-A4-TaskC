# 1) 10% random sample, keeping only rows with a price and a description.
set.seed(123)
samp <- prop |>
filter(!is.na(price), !is.na(description)) |>
slice_sample(prop = 0.1)
samp <- prop |>
filter(!is.na(sold_price), !is.na(description)) |>
slice_sample(prop = 0.1)
cat("Sample size", nrow(samp), "\n")
# 2) Clean the description text:
clean_test <- samp$description |>
str_to_lower() |>  # lawer case
str_replace_all("[^a-z ]+"," ") |>  # keep pure letters. Drop all numbers
str_squish() #  collapse multiple space, so later easier to split text.
