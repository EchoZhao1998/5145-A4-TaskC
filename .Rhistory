# Plug in suburb's median value of area and parking into prediction model
# In order to remove impact of outliers, using Median instead of Mean.
typical <- prop_q6 |>
filter( beds >= 4, baths >= 2) |>
group_by(suburb) |>
summarise(area = median(area),
parking = median(parking),
n_match = n(),  # number of house meet these requirements
.groups = "drop"  # always remember to keep your data clean
)
