has_shopping = str_detect(desc_lower, "shopping"),
has_primary_school = str_detect(desc_lower, "primary school"),
# Continuous time variable so the model can learn a price trend over
# the years and project it forward to a future date. The (month-1)/12
# term pins the prediction to a specific month (July 2026 = 2026.5), not
# just "sometime in 2026".
year_num = year(sold_time) + (month(sold_time) - 1) / 12)
# Cap area at the 99th percentile to limit a few giant blocks
