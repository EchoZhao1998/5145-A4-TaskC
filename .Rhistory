# --- Packages -----------------------------------------------------------
# data.table::fread is much faster than read.csv on a 512 MB file
# (~2–3 seconds vs ~1+ minute).
library(data.table)
library(dplyr)
library(tidyr)
library(ggplot2)
library(lubridate)
library(stringr)
# --- Read the CSV --------------------------------------------------------
# Update the path if your file lives somewhere else.
prop <- fread("TaskC_property_victoria.csv", encoding = "UTF-8")
# Quick sanity check
cat("Rows:", nrow(prop), " Cols:", ncol(prop), "\n")
str(prop, vec.len = 1, give.attr = FALSE)
View(prop)
knitr::opts_chunk$set(echo = TRUE, eval = T, message = F, warning = F)
# Compute NA value
miss_var_cumsum(prop)
library(naniar)
# Compute NA value
miss_var_cumsum(prop)
# Compute NA value
miss_var_cumsum(prop)
# There is 21	miss data in `suburb`
# Find the top 3 suburbs by transaction count
prop_clean <- prop |>
filter(!is.na(suburb))
# Compute the count of transactions of each suburb, then sort descently. sclice top 3
sub_count <- prop_clean |>
count(suburb, sort = TRUE, name = "transation_count")
# show top 10
head(sub_count, 10)
# Top 1 is Toorak, so there is no need to add it individually for question 1
# extract top 3
top3 <- sub_count$suburb[1:3]
top3
# Build a (suburb + month) count table for 2022 only.
monthly_2022 <- prop_clean |>
filter(year(sold_time) == 2022,
suburb %in% top3) |>
count(suburb, month = month(sold_time), name = "transation_counts") |>
arrange(suburb, month)
# Transfer long to wide format
monthly_2022 %>%
pivot_wider(names_from = month, values_from = transation_counts)
# Plot it
ggplot(monthly_2022, aes(x = month, y = transation_counts, colour = suburb, group = suburb)) +
geom_line(linewidth = 1) +
geom_point(size = 2) +
scale_x_continuous(breaks = 1:12, labels = month.abb) +  # 12 months and show as abbr, saving space and looks tidier.
labs(title = "Monthly property transactions in 2022",
x = "Month",
y = "Number of Transactions") +
theme_minimal(base_size = 12)
library(Matrix)   # sparse document-term matrix
library(glmnet)   # LASSO
# STEP1: 10% random sample, keeping only rows with a price and a description.
set.seed(123)
samp <- prop |>
filter(!is.na(sold_price), !is.na(description)) |>
slice_sample(prop = 0.1)
cat("Sample size:", nrow(samp), "rows\n")
# Having a look at the top 10 row of sample$desriptiin,
# Figue out what kind of messy should we clean
# head(samp$description, 10)
# STEP2: Clean the description text:
clean_text <- samp$description |>
str_replace_all("<[^>]+>", " ") |> # strip HTML tags like <br/>
str_to_lower() |>  # lawer case
str_replace_all("[^a-z ]+"," ") |>  # keep pure letters. Drop all numbers
str_squish()  # collapse multiple space, so later easier to split text.
# STEP3: Tokenise and explode into a long (doc, term) table using data.table
#    (this is one of the speed-critical bits — a 10% sample is still ~37k docs
#    and 28k+ unique terms).
tokens <- str_split(clean_text, " ")
dtm_long <- data.table(doc  = rep(seq_along(tokens), lengths(tokens)),
term = unlist(tokens))
# STEP4: Drop very short tokens and a basic English stop-word list, plus a few generic real-estate words that appear in almost every listing.
stopwords_en <- c(
"i","me","my","we","our","you","your","he","she","it","its","they","them",
"this","that","these","those","is","are","was","were","be","been","being",
"have","has","had","do","does","did","a","an","the","and","or","but","if",
"as","of","at","by","for","with","about","against","between","into","through",
"during","before","after","above","below","to","from","up","down","in","out",
"on","off","over","under","again","further","then","once","here","there",
"when","where","why","how","all","any","both","each","few","more","most",
"other","some","such","no","nor","not","only","own","same","so","than",
"too","very","s","t","can","will","just","don","should","now",
"amp","br","lt","gt","quot","apos",                # HTML leftovers
"also","new","one","two","three","four","five",
"feature","features","property","home","house","bed","bedroom","bedrooms",
"bath","bathroom","bathrooms","room","rooms","living","please","including",
"call","inspection","view","contact","auction","sale"   # generic listing terms
)
dtm_long <- dtm_long[term != "" & nchar(term) >= 3]
dtm_long <- dtm_long[!term %in% stopwords_en]
# nrow(dtm_long) -4041531
# STEP5: Vocabulary filter: keep only terms that appear in at least 1% of docs.
# Filter: Rare/unique words make the model unstable; very common words don't help either.
min_df <- ceiling(0.01 * nrow(samp))
keep_terms <- dtm_long[, .(df = uniqueN(doc)), by = term][df >= min_df, term]
dtm_long <- dtm_long[term %in% keep_terms]
dtm_long <- unique(dtm_long, by = c("doc", "term"))   # collapse to PRESENCE
cat("Vocabulary size after filtering:", length(keep_terms), "terms\n")
# STEP6: Build the sparse document-term matrix
term_levels <- sort(unique(dtm_long$term))
dtm <- sparseMatrix(
i = dtm_long$doc,
j = match(dtm_long$term, term_levels),
x = 1,
dims = c(nrow(samp), length(term_levels)),
dimnames = list(NULL, term_levels)
)
dim(dtm)
# 7) Fit LASSO with cross-validated lambda.
y <- log(samp$sold_price)
fit <- cv.glmnet(dtm, y, alpha = 1, nfolds = 5)
# Pull non-zero coefficients at lambda.1se (the more conservative pick:
# the largest lambda whose error is within 1 SE of the minimum).
co <- coef(fit, s = "lambda.1se")
coef_tbl <- tibble(term = rownames(co)[-1],          # drop intercept
coef = as.numeric(co)[-1]) |>
filter(coef != 0) |>
arrange(desc(abs(coef)))
# Top 20 for context, then the answer (top 3)
head(coef_tbl, 20)
top3_keywords <- head(coef_tbl, 3)
top3_keywords
top3_suburbs <- c("Toorak", "Melbourne", "Clyde North")
types_wanted <- c("house", "unit", "townhouse", "apartment")
prop_q3 <- prop |>
filter(suburb %in% top3_suburbs,
property_type %in% types_wanted,
!is.na(sold_price),
!is.na(area), area > 0)
# How many suburb and property
prop_q3 |>
count(suburb, property_type) |>
pivot_wider(names_from = property_type, values_from = n, values_fill = 0)
View(samp)
head(sort(prop$sold_price),5)
tail(sort(prop$sold_price),5)
# 1) Filter to rows with valid address, plausible price, and valid date.
ok <- prop |>
filter(!is.na(address), address != "",
!is.na(sold_price), sold_price >= 50000, sold_price <= 50e6,
!is.na(sold_time))
ok_dt <- as.data.table(ok)
View(ok_dt)
per_property <- ok_dt[, .(
n_sales     = .N,
first_date  = min(sold_time),    # column first_date
last_date   = max(sold_time),    # column last_date
first_price = sold_price[which.min(sold_time)],    # column first_price
last_price  = sold_price[which.max(sold_time)]     # column last_price
), by = .(address, postcode)    # double insurance - filter the same property
][n_sales >= 2 & last_date > first_date]   # at least two different-day sales
# 3) Derive capital gain and duration in years
per_property$capital_gain <- per_property$last_price - per_property$first_price
per_property$duration_years <- as.numeric(per_property$last_date - per_property$first_date) / 365
View(per_property)
top5_q4 <- per_property |>
as_tibble() |>   # output should be a table
filter(duration_years <= 5) |>
arrange(desc(per_property)) |>
slice_head( n = 5 ) |>
mutate(duration_years = round(duration_years,2)) |>
select(address, capital_gain, duration_years,
first_date, first_price, last_date, last_price)
top5_q4 <- per_property |>
as_tibble() |>   # output should be a table
filter(duration_years <= 5) |>
arrange(desc(capital_gain)) |>
slice_head( n = 5 ) |>
mutate(duration_years = round(duration_years,2)) |>
select(address, capital_gain, duration_years,
first_date, first_price, last_date, last_price)
View(top5_q4)
top5_q4
# 3) Derive capital gain and duration in years
per_property$gain <- per_property$last_price - per_property$first_price
top5_q4 <- per_property |>
as_tibble() |>   # output should be a table
filter(duration_years <= 5) |>
arrange(desc(capital_gain)) |>
slice_head( n = 5 ) |>
mutate(duration_years = round(duration_years,2)) |>
select(address, gain, duration_years,
first_date, first_price, last_date, last_price)
top5_q4
